# ==============================================================================
# Eval Awareness Testbed - Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your API keys.
# The testbed will automatically load from .env in the working directory.
# ==============================================================================

# ------------------------------------------------------------------------------
# Model Provider API Keys (Required - at least one)
# ------------------------------------------------------------------------------

# Anthropic API key (for Claude models)
ANTHROPIC_API_KEY=

# OpenAI API key (for GPT models)
OPENAI_API_KEY=

# OpenRouter API key (for accessing multiple providers via single API)
# Recommended: provides access to Claude, GPT, Qwen, Gemini, etc.
OPENROUTER_API_KEY=

# ------------------------------------------------------------------------------
# Optional Model Provider Keys
# ------------------------------------------------------------------------------

# Google API key (for Gemini models via OpenRouter or directly)
GOOGLE_API_KEY=

# Moonshot/Kimi API key (for Moonshot models)
MOONSHOT_API_KEY=

# MiniMax API key (for MiniMax models)
MINIMAX_API_KEY=

# Hugging Face token (for model downloads and inference)
HF_TOKEN=

# ------------------------------------------------------------------------------
# Inspect AI Configuration
# ------------------------------------------------------------------------------

# Default model for Inspect AI evaluations (optional)
# If set, you don't need to pass --model to every inspect eval command
# INSPECT_EVAL_MODEL=openai/gpt-4o

# ------------------------------------------------------------------------------
# Data Generation (false-facts module)
# ------------------------------------------------------------------------------

# Exa API key (for web scraping in universe generation)
EXA_API_KEY=

# Batch processing keys (if different from primary)
# ANTHROPIC_API_KEY_BATCH=
# OPENAI_API_KEY1=

# ------------------------------------------------------------------------------
# Consistency Training (model-organism-consistency-training)
# ------------------------------------------------------------------------------

# vLLM server URL (if running local inference)
# VLLM_SERVER_URL=http://localhost:8000

# Weights & Biases (for training logging)
# WANDB_API_KEY=

# ------------------------------------------------------------------------------
# Needham Eval Configuration
# ------------------------------------------------------------------------------

# Override default data file path
# EVAL_AWARENESS_DATA_FILE=eval_awareness_val.json

# Comma-separated list of models to include in plots
# MODELS_TO_PLOT=gpt-4o,claude-3-5-sonnet-20241022,qwen-qwq-32b

# ------------------------------------------------------------------------------
# Development & Testing
# ------------------------------------------------------------------------------

# Log level for debugging
# LOG_LEVEL=INFO

# Skip Cython compilation (for development)
# SKIP_CYTHON=1
